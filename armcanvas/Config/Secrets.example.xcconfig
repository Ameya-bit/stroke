// Copy to Secrets.xcconfig (gitignored) and fill in.
GOOGLE_API_KEY =
// Apple Developer team ID (Xcode > Settings > Accounts). Leave blank to set in Xcode UI.
DEVELOPMENT_TEAM =
// Cloud Run base URL. xcconfig treats // as a comment, so write https:/$()/host
// e.g. BACKEND_URL = https:/$()/armcanvas-xxxx.a.run.app   (blank = on-device only)
BACKEND_URL =
